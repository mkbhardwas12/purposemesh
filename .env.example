# Local demonstration mode. Production mode disables the seeded directory and
# password login, and requires a unique secret plus explicit console origins.
CCA_MODE=demo
CCA_JWT_SECRET=replace-with-at-least-32-random-characters
CCA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

HOST=127.0.0.1
PORT=8787
CCA_LOG_LEVEL=info
CCA_TRUST_PROXY=false

# Demo/test create these files if needed. Newly created SQLite files are owner-only
# on POSIX systems. Production requires both files to be pre-provisioned regular
# files containing valid schemas; it opens CCA_DB read-only and never seeds either.
CCA_CONTROL_DB=./data/cca-control.sqlite
CCA_DB=./data/cca.sqlite
# Demo/test only; production never generates or resizes its warehouse.
CCA_FACT_ROWS=100000
