{
  "name": "@cca/api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "predev": "npm run build -w @cca/core",
    "dev": "CCA_MODE=demo tsx watch src/index.ts",
    "start": "node dist/index.js",
    "pretest": "npm run build -w @cca/core",
    "test": "vitest run",
    "pretypecheck": "npm run build -w @cca/core",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "npm run build -w @cca/core",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@cca/core": "0.1.0",
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.4.0",
    "jose": "^6.0.11"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
